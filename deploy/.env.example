# Shortlist deployment environment variables
# Copy to .env in deploy/ or pass to docker compose

SHORTLIST_SECRET_KEY=change-me-to-a-strong-random-fernet-key
SHORTLIST_DATABASE_URL=sqlite:////data/shortlist.db
# For PostgreSQL profile (--profile postgres):
# SHORTLIST_DATABASE_URL=postgresql+psycopg://shortlist:shortlist@postgres:5432/shortlist

SHORTLIST_API_PORT=8000
SHORTLIST_WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional profiles
POSTGRES_USER=shortlist
POSTGRES_PASSWORD=shortlist
POSTGRES_DB=shortlist
OLLAMA_PORT=11434
