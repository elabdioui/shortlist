# Multi-arch (linux/amd64, linux/arm64) Dockerfile for Shortlist Worker
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-fra tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.6 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

COPY pyproject.toml uv.lock* ./
COPY backend ./backend

# Ensure README.md exists for hatchling metadata build
RUN test -f README.md || touch README.md

RUN uv sync --no-dev --extra postgres \
    && /app/.venv/bin/python -c "import spacy; spacy.load('fr_core_news_md'); spacy.load('en_core_web_md')"

RUN useradd --create-home --shell /bin/bash shortlist \
    && mkdir -p /data \
    && chown -R shortlist:shortlist /app /data

USER shortlist

CMD ["/app/.venv/bin/python", "-m", "shortlist.worker"]
